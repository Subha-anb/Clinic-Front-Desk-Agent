# Copy to .env and fill in. Never commit .env.

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_ENABLED=true                 # false = rules + offline templates only

# --- Security -------------------------------------------------------------
# Long random secret used to pseudonymise phone numbers (patient_ref). Rotating it breaks
# the link to existing records, so store it in your secret manager.
PII_PEPPER=
# Bearer token shared with n8n for /internal/* endpoints and the handoff webhook.
INTERNAL_API_TOKEN=

# --- WhatsApp Cloud API ---------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=             # used to verify X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=           # any random string; also entered in the Meta dashboard

# --- Storage --------------------------------------------------------------
STORE_BACKEND=local              # local | google
DATA_DIR=./data
USE_MCP=true                     # agent calls tools via the MCP server (stdio)

# Google (STORE_BACKEND=google)
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/clinic-sa.json
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=

# --- n8n ------------------------------------------------------------------
N8N_HANDOFF_WEBHOOK_URL=https://n8n.example.com/webhook/clinic-handoff
