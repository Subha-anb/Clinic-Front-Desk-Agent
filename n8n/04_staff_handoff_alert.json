{
  "name": "Clinic - Staff handoff alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "clinic-handoff",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "46993beb-8ca7-5cc5-9a33-12d58269b196",
      "name": "Handoff created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Clinic internal API (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.priority }}",
              "rightValue": "urgent",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1b749903-e2f6-57a8-8697-e28576818dd9",
      "name": "Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.CLINIC_ALERT_FROM }}",
        "toEmail": "={{ $env.CLINIC_STAFF_EMAIL }}",
        "subject": "=URGENT patient message {{ $json.body.handoff_id }} - call the patient now",
        "emailFormat": "text",
        "text": "=Ticket {{ $json.body.handoff_id }} ({{ $json.body.category }}, {{ $json.body.priority }}).\nOpen the Handoffs tab in the clinic sheet to read it and reply to the patient on WhatsApp.",
        "options": {}
      },
      "id": "4c80a964-5efa-50ed-b297-ec301795aa8c",
      "name": "Email staff - URGENT",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        480,
        -100
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_ME",
          "name": "Clinic SMTP"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.CLINIC_ALERT_FROM }}",
        "toEmail": "={{ $env.CLINIC_STAFF_EMAIL }}",
        "subject": "=New patient question {{ $json.body.handoff_id }} ({{ $json.body.category }})",
        "emailFormat": "text",
        "text": "=Ticket {{ $json.body.handoff_id }} ({{ $json.body.category }}, {{ $json.body.priority }}).\nOpen the Handoffs tab in the clinic sheet to read it and reply to the patient on WhatsApp.",
        "options": {}
      },
      "id": "35d61d9c-4553-5c12-ae5e-1b17ad00b40b",
      "name": "Email nursing queue",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        480,
        100
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_ME",
          "name": "Clinic SMTP"
        }
      }
    }
  ],
  "connections": {
    "Handoff created": {
      "main": [
        [
          {
            "node": "Urgent?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Urgent?": {
      "main": [
        [
          {
            "node": "Email staff - URGENT",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email nursing queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "pinData": {},
  "meta": {
    "note": "Payload carries only handoff_id, category and priority. Message text stays in the restricted sheet."
  }
}
